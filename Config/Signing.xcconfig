// Signs ad hoc by default so the project builds on any Mac.
// To keep Input Monitoring granted across rebuilds, sign with a stable identity:
// copy Signing.local.example.xcconfig to Signing.local.xcconfig and fill it in.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
